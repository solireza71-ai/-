rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // پروفایل: هر کاربر فقط پروفایل خودش را می‌خواند.
    // از داخل اپ فقط email و updatedAt قابل نوشتن است (نام و کد پرسنلی را فقط شما در Console ثبت می‌کنید).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'updatedAt']);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if false;
    }

    // مانده مرخصی: فقط خواندن. تغییرش فقط از Console انجام می‌شود.
    match /leaveBalances/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // درخواست‌ها: کاربر فقط درخواست‌های خودش را می‌بیند و فقط می‌تواند درخواست «در انتظار» ثبت کند.
    // تأیید/رد فعلاً از Console انجام می‌شود.
    match /leaveRequests/{requestId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update, delete: if false;
    }

    match /leaveTransactions/{transactionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
